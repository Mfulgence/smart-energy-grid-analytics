energy_readings_3h   | energy_readings_3h_meter_time_idx   | CREATE INDEX energy_readings_3h_meter_time_idx ON public.energy_readings_3h USING btree (meter_id, event_time DESC)    
energy_readings_3h   | energy_readings_3h_time_idx         | CREATE INDEX energy_readings_3h_time_idx ON public.energy_readings_3h USING btree (event_time DESC)                    
