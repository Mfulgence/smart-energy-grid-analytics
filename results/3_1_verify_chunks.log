--- Chunk interval of each hypertable ---
-- The configured chunk interval of every hypertable under comparison.
SELECT hypertable_name,
       column_name          AS partition_column,
       time_interval::text  AS chunk_interval
FROM timescaledb_information.dimensions
WHERE hypertable_name = ANY(%(tables)s)
ORDER BY time_interval

hypertable_name      | partition_column | chunk_interval
---------------------+------------------+---------------
energy_readings_3h   | event_time       | 03:00:00      
energy_readings      | event_time       | 1 day         
energy_readings_week | event_time       | 7 days        
(3 rows)
Time: 10.9 ms

--- Chunk count and time range ---
-- How many chunks each table actually has and the time range they span.
-- Chunk boundaries are aligned to UTC, i.e. 02:00 CAT. That is why the
-- one-day table has 29 chunks for 28 CAT days: the first and last CAT day
-- each fall partly into an extra chunk.
SELECT hypertable_name,
       count(*)          AS chunk_count,
       min(range_start)  AS first_chunk_start,
       max(range_end)    AS last_chunk_end
FROM timescaledb_information.chunks
WHERE hypertable_name = ANY(%(tables)s)
GROUP BY hypertable_name
ORDER BY chunk_count DESC

hypertable_name      | chunk_count | first_chunk_start        | last_chunk_end          
---------------------+-------------+--------------------------+-------------------------
energy_readings_3h   | 225         | 2026-08-31 23:00:00+0200 | 2026-09-29 02:00:00+0200
energy_readings      | 29          | 2026-08-31 02:00:00+0200 | 2026-09-29 02:00:00+0200
energy_readings_week | 5           | 2026-08-27 02:00:00+0200 | 2026-10-01 02:00:00+0200
(3 rows)
