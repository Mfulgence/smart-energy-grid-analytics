SELECT count(*)                 AS row_count,
       count(DISTINCT meter_id) AS distinct_meters,
       min(event_time)          AS earliest_event_time,
       max(event_time)          AS latest_event_time,
       sum(power_kw)            AS sum_power_kw,
       sum(energy_kwh)          AS sum_energy_kwh
