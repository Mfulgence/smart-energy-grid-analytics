agg_meter_daily   |  SELECT time_bucket('1 day'::interval, event_time, 'Africa/Kigali'::text) AS bucket,
    meter_id,
    sum(energy_kwh) AS energy_kwh_sum,
    sum(power_kw) AS power_kw_sum,
    count(*) AS reading_count
   FROM energy_readings
  GROUP BY (time_bucket('1 day'::interval, event_time, 'Africa/Kigali'::text)), meter_id;                                                                    
agg_region_15min  |  SELECT time_bucket('00:15:00'::interval, r.event_time) AS bucket,
    m.region,
    sum(r.energy_kwh) AS energy_kwh_sum,
    sum(r.power_kw) AS power_kw_sum,
    count(*) AS reading_count
   FROM (energy_readings r
     JOIN meters m ON ((m.meter_id = r.meter_id)))
  GROUP BY (time_bucket('00:15:00'::interval, r.event_time)), m.region;                                              
agg_region_hourly |  SELECT time_bucket('01:00:00'::interval, r.event_time, 'Africa/Kigali'::text) AS bucket,
    m.region,
    sum(r.energy_kwh) AS energy_kwh_sum,
