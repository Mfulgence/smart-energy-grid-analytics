# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so real passwords never reach GitHub.

# --- PostgreSQL / TimescaleDB ------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your-postgres-password>
PGDATABASE=energy_grid

# --- EMQX MQTT broker ----------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave both empty if your broker allows anonymous clients (the EMQX default).
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Facts that a program cannot detect reliably (used by s11_environment.py) --
# How PostgreSQL runs: "native", "Docker container (limits: none)", "VM (4 vCPU, 8 GB)" ...
PG_RUNTIME=<native | container | virtual machine, with any CPU/RAM limits>
# Storage type of the disk that holds the database: "NVMe SSD", "SATA SSD", "HDD" ...
STORAGE_TYPE=<storage type>
# EMQX version (shown by "emqx ctl status" or on the EMQX dashboard at http://localhost:18083)
EMQX_VERSION=<emqx version>
